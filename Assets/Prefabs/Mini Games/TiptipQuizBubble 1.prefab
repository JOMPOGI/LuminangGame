  quizzes:
  - quizId: A
    question: 'Quick! Ronnie seems friendly.

      How do you say ''good day'' in
      Cebuano?'
    correctAnswer: Maayong aldaw
    wrongAnswers:
    - paalam
    - maayo ra ko
    - kumusta
  - quizId: B
    question: 'Ronnie asked if you''d like to see his work.

      What do you say
      if you AGREE?'
    correctAnswer: oo
    wrongAnswers:
    - dili
    - dili ko kasabot
    - paalam
  - quizId: C
    question: 'Ronnie helped you so much!

      How do you say ''thank you for your
      help''?'
    correctAnswer: salamat sa imong tabang
    wrongAnswers:
    - pasayloa ko
    - tabi
    - daghang salamat
