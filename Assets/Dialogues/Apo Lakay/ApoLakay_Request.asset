  m_Script: {fileID: 11500000, guid: 73ff519377b990a4c81cd1461a3c1f62, type: 3}
  m_Name: ApoLakay_Request
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  speakerName: Apo Lakay
  speakerPortrait: {fileID: 21300000, guid: a6fe17a2d439d18459e035bb2968ecb3, type: 3}
  dialogueText: Mabalin kadi a tumulongka a mangibilang kadagiti tattao ditoy? Masapulko
    nga ammoan no asino dagiti makipartisipar iti panagsagsagana para iti festival,
    ngem nabannogakon unay tapno agliklikmut pay.
  translatedText: "Can you help me keep track of the people here? I need to know
    who will participate in the festival preparations, but I\u2019m already too tired
    to walk around."
