  m_Script: {fileID: 11500000, guid: 73ff519377b990a4c81cd1461a3c1f62, type: 3}
  m_Name: ApoLakay_HandGesture
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  speakerName: Apo Lakay
  speakerPortrait: {fileID: 21300000, guid: a6fe17a2d439d18459e035bb2968ecb3, type: 3}
  dialogueText: "Makita ko ti anting-anting mo\u2026 ammok dayta a kristal a birbirokem.
    Saan a bassit ti kaipapananna. Adda pamilya a nakikadua iti dayta idi\u2014agsasapulda
    iti merkado. No kayat mo a maammoan pay, sadiay ka a mapan."
  translatedText: "I can see your amulet\u2026 I know that it is the crystal you
    are searching for. It is not something small. There was a family once connected
    to it\u2014they used to trade in the market. If you want to learn more, that
    is where you should go."
  animationTrigger: Pointing
  triggerEventName: 
  endEventName: 
  choices: []
