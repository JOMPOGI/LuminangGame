  speakerName: Apo Lakay
  speakerPortrait: {fileID: 21300000, guid: a6fe17a2d439d18459e035bb2968ecb3, type: 3}
  dialogueText: "The Language Crystal is glowing brightly now! You have rekindled the memories of our Ilokano language. The words, the stories, the songs... they live on because of you. Agyamanak unay, traveler. Our language lives once again."
  translatedText: "The crystal glows! You have rekindled our language. Thank you, traveler."
