  m_Script: {fileID: 11500000, guid: 73ff519377b990a4c81cd1461a3c1f62, type: 3}
  m_Name: Kalaw_Intro_Yes
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  speakerName: Kalaw
  speakerPortrait: {fileID: 21300000, guid: e9a1f2822809deb49a0ce098da0fddca, type: 3}
  dialogueText: "Mmm, sweet and juicy! Thank you so much, traveler!\n\nAh, where
    are my manners\u2014I am Kalaw, your companion and guide through these lands!\n\nTo
    truly experience the beauty of Vigan, you've got to explore Calle Crisologo and
    speak with the locals in their native tongue.\n\nAs you practice and learn how
    Ilocanos talk in their daily lives, you will earn their trust and friendship.\n\nSo,
    let's begin with something simple.\n\nBefore you can truly connect with the people
    of Ilocos, you must first learn how to greet them."
